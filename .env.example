# --- LLM provider (Groq by default) ---
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Model served by Groq (default: llama-3.3-70b-versatile)
LLM_MODEL=llama-3.3-70b-versatile

# --- Agent tuning (all optional) ---
# Endpoints per LLM call (smaller = more compact prompts, friendlier to free-tier limits)
AGENT_BATCH_SIZE=4
# Hard cap on endpoints analyzed per run (protects token-per-minute limits)
AGENT_MAX_ENDPOINTS=30
# Requests per second against the target API
AGENT_RATE_LIMIT_RPS=5
# HTTP timeout (seconds) for calls to the target API
AGENT_REQUEST_TIMEOUT=15
# Responses slower than this (milliseconds) are flagged as anomalies
AGENT_SLOW_THRESHOLD_MS=1000

# --- Storage ---
REPORTS_DB=reports.db
GENERATED_TESTS_DIR=generated_tests
